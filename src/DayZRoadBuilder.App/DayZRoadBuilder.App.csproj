<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DayZRoadBuilder.App</RootNamespace>
    <AssemblyName>DayZRoadBuilder</AssemblyName>
    <!-- Also runs if only a newer .NET runtime (9, 10, ...) is installed -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DayZRoadBuilder.Core\DayZRoadBuilder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- No form designer: the UI is built in code -->
    <Compile Update="MainForm.cs" SubType="Code" />
    <Compile Update="PreviewControl.cs" SubType="Code" />
  </ItemGroup>

</Project>
