<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DayZRoadBuilder.App</RootNamespace>
    <AssemblyName>DayZRoadBuilder</AssemblyName>
    <!-- Läuft auch, wenn nur eine neuere .NET-Version (9, 10, ...) installiert ist -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DayZRoadBuilder.Core\DayZRoadBuilder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kein Formular-Designer: die Oberfläche wird im Code aufgebaut -->
    <Compile Update="MainForm.cs" SubType="Code" />
    <Compile Update="PreviewControl.cs" SubType="Code" />
  </ItemGroup>

</Project>
